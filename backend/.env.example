# ─── MongoDB Credentials ────────────────────────────────────────────────────
# NEVER commit a real value here — copy this file to .env and fill it in
# Use a MongoDB Atlas connection string (includes TLS by default via mongodb+srv://)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kalaakart?retryWrites=true&w=majority

# ─── JWT Secret ─────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRY=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Admin Panel ─────────────────────────────────────────────────────────────
# Used to gate /api/admin routes — change from default before going live
ADMIN_PIN=REPLACE_WITH_SECURE_PIN

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max login/signup attempts per window per IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# ─── CORS ────────────────────────────────────────────────────────────────────
# Space-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000 https://yourdomain.github.io
